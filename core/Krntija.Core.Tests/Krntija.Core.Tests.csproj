<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Krntija.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit.v3 запускается как обычный exe: не нужен testhost и его возня с правами -->
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Krntija.Core\Krntija.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Образцы сейвов прошлых версий (ADR 0002, п. 6): тесты читают их с диска. -->
    <None Update="Saves\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
